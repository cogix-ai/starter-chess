#!/usr/bin/env bash
# DO NOT EDIT. Serves your bot on http://127.0.0.1:8700. Set COGIX_AGENT_TOKEN first.
set -euo pipefail
cd "$(dirname "$0")"
if [ -z "${COGIX_AGENT_TOKEN:-}" ]; then echo "Set COGIX_AGENT_TOKEN first (see README.md)."; exit 1; fi
# Install the bundled SDK, again whenever it changes (a stale copy is how
# a command goes missing).
STAMP=$(cd sdk && find . -type f -not -path "*/__pycache__/*" | sort | xargs cat | shasum | cut -c1-16)
if [ ! -x .venv/bin/python ] || [ "$(cat .venv/.sdk-stamp 2>/dev/null)" != "$STAMP" ]; then
  echo "Setting up the local Python environment…"
  [ -x .venv/bin/python ] || python3 -m venv .venv
  .venv/bin/pip install -q --disable-pip-version-check --force-reinstall --no-deps ./sdk
  .venv/bin/pip install -q --disable-pip-version-check ./sdk
  echo "$STAMP" > .venv/.sdk-stamp
fi
exec .venv/bin/python main.py
